# Paddle + RevenueCat global pricing (docs/PADDLE_REVENUECAT.md). Copy to .env (git-ignored).
# Vite stops when a test or sandbox run holds a production key (src/utils/payments/keyGuard.ts).
# sandbox (default) | production
VITE_PADDLE_ENVIRONMENT=sandbox
# Paddle client-side token: test_... in sandbox, live_... in production
VITE_PADDLE_CLIENT_TOKEN=
# one Paddle price per tier and interval (pri_...); regional amounts are price overrides
VITE_PADDLE_PRICE_EXPLORER_MONTH=
VITE_PADDLE_PRICE_EXPLORER_YEAR=
VITE_PADDLE_PRICE_MANAGER_MONTH=
VITE_PADDLE_PRICE_MANAGER_YEAR=
VITE_PADDLE_PRICE_LEADER_MONTH=
VITE_PADDLE_PRICE_LEADER_YEAR=
# RevenueCat Web Billing public key: rcb_sb_... (sandbox) or rcb_... (production). Never sk_.
VITE_REVENUECAT_WEB_API_KEY=
# #312 Stripe test mode (pk_test_ only)
VITE_STRIPE_PUBLISHABLE_KEY=
