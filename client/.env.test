# Paddle + RevenueCat: placeholders for test runs (vite --mode test, used by the e2e suite).
# Sandbox only, no real keys. Vite refuses to start if any of these is a production key.
VITE_PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_CLIENT_TOKEN=test_placeholder_not_a_real_token
VITE_PADDLE_PRICE_EXPLORER_MONTH=pri_placeholder_explorer_month
VITE_PADDLE_PRICE_EXPLORER_YEAR=pri_placeholder_explorer_year
VITE_PADDLE_PRICE_MANAGER_MONTH=pri_placeholder_manager_month
VITE_PADDLE_PRICE_MANAGER_YEAR=pri_placeholder_manager_year
VITE_PADDLE_PRICE_LEADER_MONTH=pri_placeholder_leader_month
VITE_PADDLE_PRICE_LEADER_YEAR=pri_placeholder_leader_year
VITE_REVENUECAT_WEB_API_KEY=rcb_sb_placeholder_not_a_real_key
