{
  "name": "automation",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end Playwright tests: real client and server, in-memory Postgres (PGlite)",
  "scripts": {
    "pretest": "node scripts/prepare.mjs",
    "test": "npm run check && playwright test",
    "test:firebase-live": "node scripts/check-firebase-live-env.mjs && playwright test --config playwright.live.config.ts",
    "check": "./node_modules/.bin/prettier --check \"**/*.{ts,mjs,json,md}\" && tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "firebase-tools": "^15.37.0",
    "prettier": "^2.8.8",
    "typescript": "^6.0.3"
  }
}
