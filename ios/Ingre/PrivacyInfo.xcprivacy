<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  What the iOS app does today: reads the bundled catalogue, keeps the list in memory,
	  no network, no accounts, no analytics, no tracking, and no required-reason APIs
	  (no UserDefaults, file timestamps, disk space or boot time). Update this file
	  whenever that changes (see docs/MOBILE.md).
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
