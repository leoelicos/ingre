# Paddle + RevenueCat: placeholders for test runs (npm run start:e2e loads this file).
# Sandbox only, no real secrets: the key guard (src/payments/keyGuard.ts) stops the
# server if any of these is ever a production key.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_placeholder_not_a_real_key
PADDLE_WEBHOOK_SECRET=pdl_ntfset_placeholder_not_a_real_secret
PADDLE_PRICE_TIERS=pri_placeholder_explorer_month=EXPLORER,pri_placeholder_explorer_year=EXPLORER,pri_placeholder_manager_month=MANAGER,pri_placeholder_manager_year=MANAGER,pri_placeholder_leader_month=LEADER,pri_placeholder_leader_year=LEADER
# empty: nothing is posted to RevenueCat from test runs
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_AUTH=rc_webhook_placeholder_not_a_real_secret
REVENUECAT_ENVIRONMENT=sandbox
