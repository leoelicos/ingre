JWT_SECRET=
# #312 Stripe, test mode only (docs/STRIPE.md). Never commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# optional: pin Price ids printed by `npm run stripe:setup`
STRIPE_PRICE_EXPLORER=
STRIPE_PRICE_MANAGER=
STRIPE_PRICE_LEADER=
# #314 store subscriptions from the native apps (docs/STORE_SUBSCRIPTIONS.md).
# Leave empty to keep them off: purchases are then refused, never trusted.
GOOGLE_PLAY_PACKAGE_NAME=
# the service account key JSON (as is or base64)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# shared secret in the Pub/Sub push URL: /store/google/rtdn?token=...
GOOGLE_RTDN_TOKEN=
APPLE_BUNDLE_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
# the .p8 In-App Purchase key (newlines as \n, or base64)
APPLE_IAP_PRIVATE_KEY=
# Paddle + RevenueCat global pricing (docs/PADDLE_REVENUECAT.md). Never commit real values.
# The server refuses to start when a test or sandbox run holds a live key (src/payments/keyGuard.ts).
# sandbox | production (anything but production counts as sandbox)
PADDLE_ENVIRONMENT=sandbox
# Paddle API key: pdl_sdbx_apikey_... in sandbox (optional, for API calls)
PADDLE_API_KEY=
# the notification destination's secret key (Paddle > Developer tools > Notifications)
PADDLE_WEBHOOK_SECRET=
# optional: tiers for prices without ingre_tier custom data, e.g. pri_abc=EXPLORER,pri_def=MANAGER
PADDLE_PRICE_TIERS=
# RevenueCat's Paddle app public API key, used to post new Paddle subscriptions to /v1/receipts
REVENUECAT_API_KEY=
# the exact Authorization header value set on the RevenueCat webhook
REVENUECAT_WEBHOOK_AUTH=
# optional: sandbox | production (a test run refuses production)
REVENUECAT_ENVIRONMENT=sandbox
# Firebase Auth (docs/AUTH.md). Never commit real values.
# the Firebase Admin service account key JSON (as is or base64); empty keeps Firebase off
# and only the legacy JWT login works
FIREBASE_SERVICE_ACCOUNT_JSON=
